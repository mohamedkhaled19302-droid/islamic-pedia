{
  "manifest_version": 3,
  "name": "الموسوعة الإسلامية",
  "description": "قرآن الكريم، تفسير، أحاديث، أذكار، مواقيت الصلاة، تسبيح، إذاعات قرآن — في نافذة صغيرة",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "الموسوعة الإسلامية"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.aladhan.com/*"]
}
